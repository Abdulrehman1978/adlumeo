# ==============================================================================
# ADLUMEO — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SITE URL & CLIENT STATUS (Required for Production)
# ------------------------------------------------------------------------------
# Set this to your canonical production URL (e.g., https://adlumeo.vercel.app or https://yourdomain.com)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_ACCEPTING_CLIENTS=true

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PRODUCTION LAUNCH BLOCKER)
# ------------------------------------------------------------------------------
# In local development:
#   provider = "sqlite" in prisma/schema.prisma
#   DATABASE_URL="file:./dev.db"
#
# FOR PRODUCTION ON VERCEL:
#   SQLite is ephemeral and leads will be wiped on every redeploy.
#   You MUST:
#     1. Set provider = "postgresql" in prisma/schema.prisma
#     2. Set DATABASE_URL to your PostgreSQL connection string (Supabase / Neon)
#     3. Run: npx prisma migrate deploy
#
# Supplying a PostgreSQL URL alone without changing the Prisma provider to "postgresql"
# does NOT make the database production-ready.
# ------------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAIL (Resend / SMTP)
# ------------------------------------------------------------------------------
# When configured, notifies the agency inbox and sends a confirmation receipt.
# If omitted in production, leads are still safely saved to the DB, but email
# dispatch will return EMAIL_NOT_CONFIGURED rather than mocking success.
# ------------------------------------------------------------------------------
EMAIL_API_KEY=
EMAIL_FROM="ADLUMEO <notifications@your-domain.com>"
LEAD_NOTIFICATION_EMAIL="agency@your-domain.com"

# ------------------------------------------------------------------------------
# 4. RATE LIMITING (Production: Upstash Redis - Recommended)
# ------------------------------------------------------------------------------
# If provided, production uses distributed Redis rate limiting per IP.
# If omitted, falls back to memory-bounded rate limiting.
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 5. PUBLIC CONTACT & BOOKING CHANNELS (Optional)
# Only rendered on the website when genuinely provided.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PHONE_NUMBER=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_BOOKING_URL=

# ------------------------------------------------------------------------------
# 6. FOUNDER PROFILE (Optional)
# Founder section is completely omitted unless name and bio are configured.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FOUNDER_NAME=
NEXT_PUBLIC_FOUNDER_ROLE=
NEXT_PUBLIC_FOUNDER_BIO=
NEXT_PUBLIC_FOUNDER_IMAGE=

# ------------------------------------------------------------------------------
# 7. SOCIAL CHANNELS (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=

# ------------------------------------------------------------------------------
# 8. ANALYTICS (Optional - Scripts will NOT load if IDs are blank)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
