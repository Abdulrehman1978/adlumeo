# ==============================================================================
# ADLUMEO — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Site URL
NEXT_PUBLIC_SITE_URL=https://adlumeo.com

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# Intended production: PostgreSQL / Supabase.
# In local development without a database URL, the client falls back to local SQLite.
# Example PostgreSQL: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Example Local SQLite: file:./dev.db
# ------------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# RATE LIMITING (Production: Upstash Redis)
# If provided, production uses distributed Redis rate limiting per IP.
# If omitted in development, falls back to memory-bounded rate limiting.
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# TRANSACTIONAL EMAIL (Resend / SMTP)
# When configured, notifies the agency inbox and sends a confirmation receipt.
# If omitted in development, logs transmission details to the server console.
# ------------------------------------------------------------------------------
EMAIL_API_KEY=
EMAIL_FROM="ADLUMEO <audits@adlumeo.com>"
LEAD_NOTIFICATION_EMAIL="director@adlumeo.com"

# ------------------------------------------------------------------------------
# DIRECT CONTACT & BOOKING CHANNELS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_BOOKING_URL=

# ------------------------------------------------------------------------------
# OPTIONAL ANALYTICS (Scripts will NOT load if IDs are blank)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
